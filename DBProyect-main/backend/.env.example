PORT=3000
JWT_SECRET=cambia-este-secreto

# Hospital General -> PostgreSQL
PG_URL=postgresql://postgres:postgres@localhost:5432/hospital_general

# Centro Médico Pediátrico -> MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=centro_pediatrico

# Laboratorio Clínico -> MongoDB (el mismo que ves en Compass)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=laboratorio_clinico

# Clínica Odontológica -> Firebase (Cloud Firestore)
# Opción A: cuenta de servicio de tu proyecto Firebase
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
# Opción B: emulador local (sin credenciales):  FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_PROJECT_ID=clinica-odontologica
